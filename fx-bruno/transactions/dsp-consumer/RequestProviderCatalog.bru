meta {
  name: RequestProviderCatalog
  type: http
  seq: 1
}

post {
  url: {{CONSUMER_MANAGEMENT}}/v3/catalog/request
  body: json
  auth: inherit
}

body:json {
  {
    "@context": {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "counterPartyAddress": "http://dsp-native-basyx:8090/dsp",
    "counterPartyId": "did:web:provider-idhub:user:provider",
    "protocol": "dataspace-protocol-http"
  }
}

script:post-response {
  const dcat = res.getBody()["dcat:dataset"];
  
  const assetId = dcat[0]["@id"];
  const offerId = dcat[0]['odrl:hasPolicy'][0]['@id'];
  
  bru.setEnvVar("target-asset", assetId);
  bru.setEnvVar("offerId", offerId);
}

settings {
  encodeUrl: true
  timeout: 0
}
